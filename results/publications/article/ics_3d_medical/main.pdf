dup 114 /r put
dup 115 /s put
dup 54 /six put
dup 116 /t put
dup 51 /three put
dup 50 /two put
dup 117 /u put
dup 120 /x put
dup 48 /zero put
readonly def
currentdict end
currentfile eexec
